# Existing database and authentication settings
db_host=localhost
db_user=root
db_password=1234
db_name=tenant
SECRET_KEY=replace-with-a-long-random-secret

# SMTP settings used to verify admin@gmail.com ownership
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM=Tenant Website <no-reply@example.com>
FRONTEND_URL=http://localhost:5173

# Razorpay test/live credentials. Configure the webhook URL as
# https://<your-api-host>/payments/webhook and subscribe to payment.captured,
# payment.failed, and refund.processed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
